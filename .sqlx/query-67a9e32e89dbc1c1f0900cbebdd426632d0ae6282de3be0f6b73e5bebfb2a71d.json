  "query": "\n        SELECT\n            r.name AS \"repo!: String\",\n            w.slug AS \"slug!: String\",\n            w.title AS \"title!: String\",\n            w.body AS \"body!: String\",\n            w.created_at AS \"created_at!: String\",\n            w.updated_at AS \"updated_at!: String\"\n        FROM wiki_pages w\n        JOIN repos r ON r.id = w.repo_id\n        WHERE w.repo_id = ?\n          AND w.slug = ?\n    ",
