  "query": "SELECT r.name AS \"repo!: String\", i.number AS \"number!: i64\", i.title AS \"title!: String\", i.body AS \"body!: String\", i.state AS \"state!: String\", i.locked_by AS \"locked_by?: String\", i.created_at AS \"created_at!: String\", i.updated_at AS \"updated_at!: String\", COALESCE(s.is_terminal, 0) AS \"is_terminal!: i64\" FROM issues i JOIN repos r ON r.id = i.repo_id LEFT JOIN issue_states s ON s.repo_id = i.repo_id AND s.name = i.state ORDER BY r.name, i.number",
